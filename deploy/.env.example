# No passwords or Tailscale auth keys. Safe limits; production uses owner MFA and Caddy HTTPS.
MAX_FILESIZE_BYTES=1073741824
MAX_SIMULTANEOUS_JOBS=1
JOB_TIMEOUT_SECONDS=1800
INFO_TIMEOUT_SECONDS=90
MIN_FREE_DISK_BYTES=1073741824
MAX_TEMP_BYTES_PER_JOB=3221225472
MAX_STORAGE_BYTES=6442450944
JOB_TTL_SECONDS=7200
JOB_CLEANUP_INTERVAL_SECONDS=30
MAX_JOB_HISTORY=30
OVD_MEMORY_LIMIT=2g
OVD_CPUS=1.5

# Persistent library is independent of the temporary quota and TTL.
MAX_LIBRARY_BYTES=107374182400
MAX_QUEUE=100
# Root paths, cookie security and localhost-only port are enforced in Compose.

# Set the selected free hostname only after final exposure review.
# OVD_ALLOWED_HOSTS=your-name.duckdns.org,127.0.0.1,localhost

# Encryption is forced in Compose; only a key FILE path is configured, never key bytes.
# Key is generated on the server, mounted read-only from outside runtime volumes.
# 100 GiB library cap needs an independent full-backup destination as it grows.
